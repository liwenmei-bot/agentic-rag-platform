# 这个文件供 docker-compose.yml 使用，跟 backend/.env（本地开发用）是两份独立的配置。
# 使用前：cp .env.example .env，然后编辑 .env 填入真实值。

# LLM 配置：默认用 DeepSeek，换成其他 OpenAI 兼容接口的模型同理，改 BASE_URL 和 MODEL_NAME 即可
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_NAME=deepseek-chat

# Neo4j 密码：只需要在这里设置一次，docker-compose 会自动用它初始化 Neo4j 容器，
# 不需要像本地开发那样先手动 docker run 一次
NEO4J_PASSWORD=your_neo4j_password_here

# Agent 联网搜索工具（可选）：不配置的话该工具会提示未配置，不影响其他功能
SERPER_API_KEY=your_serper_api_key_here
